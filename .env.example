# Mill-specific upstream API origins used by the local same-origin /api proxy.
VITE_SFP_API_BASE_URL=http://sfp-api-host:7304
VITE_NFL_API_BASE_URL=http://nfl-api-host:7304

# Optional override for the selected mill's API origin.
# VITE_TALLY_API_BASE_URL=http://temporary-api-host:7304

# Mill profile: sequoia, north-fork, or agwood. Agwood uses local mock data.
VITE_MILL_ID=agwood

# Port used by the local dashboard development and preview servers.
VITE_DASHBOARD_PORT=5173

# Comma-separated hostnames permitted to access the Vite server.
VITE_ALLOWED_HOSTS=tally.biztechro.com
