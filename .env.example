# Local Vite development settings. Production container settings live in
# docker/.env.example.

VITE_SFP_API_BASE_URL=http://sfp-api-host:7304
VITE_NFL_API_BASE_URL=http://nfl-api-host:7304

# Optional override for the selected mill's API origin.
# VITE_TALLY_API_BASE_URL=http://temporary-api-host:7304

# Mill profile: sequoia, north-fork, or agwood. Agwood uses local mock data.
VITE_MILL_ID=agwood

# Port and comma-separated host allowlist for the local Vite server.
VITE_DASHBOARD_PORT=5173
VITE_ALLOWED_HOSTS=tally.example.internal

# Deterministic demo seed used by bin/start.sh -demo or bin\start.bat -demo.
FAKE_DATA_SEED=demo-seed-v1
