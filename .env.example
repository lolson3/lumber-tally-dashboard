# Native nginx production settings used by bin/start.sh and bin/start.bat.
# Process/service environment variables take precedence over this file.
MILL_ID=sequoia
DEMO_MODE=false
TALLY_API_BASE_URL=http://127.0.0.1:7304
DASHBOARD_PORT=8080

# Local Vite development settings. Production container settings also have a
# dedicated template in docker/.env.example.

VITE_SFP_API_BASE_URL=http://sfp-api-host:7304
VITE_NFL_API_BASE_URL=http://nfl-api-host:7304

# Optional override for the selected mill's API origin.
# VITE_TALLY_API_BASE_URL=http://temporary-api-host:7304

# Mill profile. Cascade is the fictional, mock-data screenshot/demo profile.
VITE_MILL_ID=cascade

# Port and comma-separated host allowlist for the local Vite server.
VITE_DASHBOARD_PORT=5173
VITE_ALLOWED_HOSTS=tally.example.internal

# Deterministic demo seed used by bin/start.sh --demo or bin\start.bat --demo.
FAKE_DATA_SEED=demo-seed-v1
