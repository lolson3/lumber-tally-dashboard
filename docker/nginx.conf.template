map $uri $dashboard_cache_control {
    default "";
    ~^/(api/|readyz$) "no-store";
}

server {
    listen ${DASHBOARD_PORT};
    listen [::]:${DASHBOARD_PORT};
    server_name _;

    root "${DASHBOARD_HTML_ROOT}";
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'" always;
    add_header Cache-Control $dashboard_cache_control always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json application/manifest+json image/svg+xml text/css;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /readyz {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        access_log off;
        proxy_pass ${DASHBOARD_HEALTH_TARGET};
        proxy_pass_request_body off;
        proxy_method GET;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Host $proxy_host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 5s;
    }

    location = /runtime-config.js {
        expires -1;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        expires -1;
        default_type application/manifest+json;
        try_files $uri =404;
    }

    location = /sw.js {
        expires -1;
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location /api/ {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        expires off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;

        proxy_pass ${TALLY_API_BASE_URL};
        proxy_pass_request_body off;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
