# Required published image. Replace COMMIT_SHA with a tested full Git commit.
# A registry digest (ghcr.io/...@sha256:...) is even stronger.
DASHBOARD_IMAGE=ghcr.io/lolson3/lumber-tally-dashboard:COMMIT_SHA

# Mill-specific upstream API origins used by the container's same-origin /api proxy.
SFP_API_BASE_URL=http://sfp-api-host:7304
NFL_API_BASE_URL=http://nfl-api-host:7304

# Optional override for the selected mill's API origin.
# TALLY_API_BASE_URL=http://temporary-api-host:7304

# Mill profile. Cascade is the fictional, mock-data screenshot/demo profile.
MILL_ID=cascade
DEMO_MODE=true

# Optional deterministic demo-data seed. Demo data always covers the last 90
# calendar days.
FAKE_DATA_SEED=demo-seed-v1

# Host port mapped to nginx port 8080 for access from the permitted LAN.
DASHBOARD_HOST_PORT=8080
